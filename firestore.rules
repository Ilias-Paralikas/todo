rules_version = '2';

// Database security rules (DECISIONS D4). This file does nothing on its own:
// replace OWNER_UID with your User UID (README, step 3), then paste the whole file into
// Firebase console → Firestore Database → Rules, and click Publish (README, step 5).
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the owner, signed in, can read or write, and only under their own users/{uid}.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && uid == "JL0tj6lwNUal2VmZszwNIp4izaB3";
    }
  }
}
